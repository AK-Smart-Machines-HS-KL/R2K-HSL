#!/usr/bin/env bash
# =====================================================================
# K1 WiFi profile: "lab"
# ---------------------------------------------------------------------
# Our own lab network. Keep this file stable — new venues get their own
# profile file (copy venue_draft.env); lab tests always use this one.
#
# Sourced by:
#   utils/wifi/set_field_wifi.sh  (ON the K1 — installs the NM profile)
#   utils/wifi/setup_K1_Network.sh (FROM laptop — pushes the above)
#   utils/wifi/wifi_check.sh      (ON the K1 — validation)
# =====================================================================

# lab => FIELD_DEBUG_IP may be set (debug via laptop is allowed in the lab).
# match => FIELD_DEBUG_IP MUST stay empty (RULE VIOLATION if we access via
# laptop during a real match — ros2k-hsl Rules §3.9).
VENUE=lab

FIELD_SSID=R2k_Lab
FIELD_SECURITY=wpa-psk           # wpa-psk | sae | open (venue announces)
FIELD_PASS=ros2kickers
FIELD_SUBNET=24
FIELD_PREFIX=192.168.0           # lab default; venue assigns the team range
FIELD_GATEWAY=                   # empty = robots have NO default route (no internet on field)

# bot -> last octet: bot N resolves to ${FIELD_PREFIX}.${FIELD_IP_N}
FIELD_IP_1=101
FIELD_IP_2=102
FIELD_IP_3=103
FIELD_IP_4=104
FIELD_IP_5=105
FIELD_IP_6=106

# Forward-compat for the team UDP-broadcast channel (later session).
# Derived from prefix for a /24 (first 2 octets + .255).
FIELD_BCAST=192.168.0.255

# DEBUG SINK (later session). MUST stay EMPTY during real matches (# 3.9: any
# team access/remote-processing during play is a rule violation — debug is
# only permitted as <=1 UDP packet/s per robot on the WIRED network, see 3.9.5).
# For lab use only.
FIELD_DEBUG_IP=
