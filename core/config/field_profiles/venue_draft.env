#!/usr/bin/env bash
# =====================================================================
# K1 WiFi profile TEMPLATE: "venue" — FILL AT THE COMPETITION SITE
# ---------------------------------------------------------------------
# Rules reference: ros2k-hsl Rules.pdf §3.9 (Communication), §1.8 (Technical Area)
#
# What the organizers announce on-site (§3.9.2):
#   - The wireless access point is PROVIDED BY THE ORGANIZERS. It must be
#     used for ALL wireless communication during the game. No other 2.4 GHz
#     or 5 GHz radio equipment (cell phones, Bluetooth) near the field.
#   - Network configuration (IP addresses, channels, SSIDs, required
#     encryption) is announced at the competition site.
#   - Each team gets ONE IP RANGE for its robots AND computers.
#
# How to use:
#   1. Copy this file:  venue_<city><year>.env  (ignored by git — never commit
#      a real venue file, it carries the wifi password).
#   2. Fill every _FILL_ placeholder from the organizer announcement.
#   3. Provision:  utils/wifi/setup_K1_Network.sh --profile venue_<city><year> <Robot_IP> <bot>
#   4. Validate:   utils/wifi/wifi_check.sh ...  (see docs/field_network.md)
# =====================================================================

# match => FIELD_DEBUG_IP MUST stay empty. Any laptop access / remote
# processing during a real match is a rule violation (Rules §3.9; debug
# exception is WIRED ONLY, <=1 packet/s per robot, §3.9.5).
VENUE=match

FIELD_SSID=_FILL_                          # organizer SSID
FIELD_SECURITY=_FILL_                      # wpa-psk | sae | open (as announced)
FIELD_PASS=_FILL_                          # from organizer (may be empty if 'open')
FIELD_SUBNET=24                            # adjust if organizer assigns non-/24
FIELD_PREFIX=_FILL_                        # e.g. 10.2.3  (first 3 octets of OUR team range)
FIELD_GATEWAY=                             # keep EMPTY unless the organizers provide a gateway

# bot -> last octet INSIDE THE TEAM RANGE assigned to us (prefix above).
# Check the assignment sheet: bots must not collide with the AP itself,
# other teams, or our wired debug laptop.
FIELD_IP_1=_FILL_                          # K1 master (brain) — player 1
FIELD_IP_2=_FILL_
FIELD_IP_3=_FILL_
FIELD_IP_4=_FILL_
FIELD_IP_5=_FILL_
FIELD_IP_6=_FILL_

# Derived from prefix for a /24 — set explicitly if the venue uses another mask.
FIELD_BCAST=_FILL_

# MUST remain empty at a real match (see VENUE comment above).
FIELD_DEBUG_IP=
