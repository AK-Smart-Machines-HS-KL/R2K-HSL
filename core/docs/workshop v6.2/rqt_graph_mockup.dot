digraph ROS2K_rqt_graph {
    graph [
        rankdir=LR
        fontname="Helvetica"
        fontsize=10
        labelloc="t"
        label="rqt_graph — ROS2K v6.2 Node Graph (mockup)\n\novals = ROS2 nodes   |   squares = topics   |   blue arrows = publish   |   green arrows = subscribe"
        compound=true
        splines=true
        nodesep=0.4
        ranksep=1.2
        bgcolor="#2b2b2b"
        fontcolor="#cccccc"
    ]
    node [fontname="Helvetica", fontsize=9]
    edge [fontname="Helvetica", fontsize=7, color="#888888"]

    // ====== NODES (ovals, colored by layer) ======

    // Gazebo (simulator — gray)
    GAZEBO [label="/gazebo\n(Gazebo\nSimulator)", shape=ellipse, style="filled", fillcolor="#6a6a6a", fontcolor="#ffffff", fontsize=8]

    // Perception (green)
    TRACKER [label="tracker\n(WorldModelTracker)", shape=ellipse, style="filled", fillcolor="#4caf50", fontcolor="#1a1a1a", fontsize=8]

    // Engine (blue)
    REFEREE [label="referee_node\n(RefereeNode)", shape=ellipse, style="filled", fillcolor="#42a5f5", fontcolor="#1a1a1a", fontsize=8]
    SCORE [label="score_node\n(ScoreNode)", shape=ellipse, style="filled", fillcolor="#42a5f5", fontcolor="#1a1a1a", fontsize=8]
    REWARD [label="reward_node\n(RewardNode)", shape=ellipse, style="filled", fillcolor="#42a5f5", fontcolor="#1a1a1a", fontsize=8]

    // Aggregator (purple)
    AGG [label="state_aggregator\n(StateAggregator)", shape=ellipse, style="filled", fillcolor="#ab47bc", fontcolor="#ffffff", fontsize=8]

    // Red team (red)
    RED [label="rule_evaluator_red\n(TeamRedEvaluator)", shape=ellipse, style="filled", fillcolor="#ef5350", fontcolor="#ffffff", fontsize=8]

    // Bridge (green-dark)
    BRIDGE [label="hal_bridge\n(HalBridge)", shape=ellipse, style="filled", fillcolor="#2e7d32", fontcolor="#ffffff", fontsize=8]

    // ====== TOPICS (squares, light gray) ======
    T_MODEL_STATES [label="/gazebo/\nmodel_states", shape=box, style="filled", fillcolor="#b0b0b0", fontcolor="#1a1a1a", fontsize=7]
    T_CLOCK [label="/clock", shape=box, style="filled", fillcolor="#b0b0b0", fontcolor="#1a1a1a", fontsize=7]
    T_WORLD_POS [label="/world_\npositions", shape=box, style="filled", fillcolor="#b0b0b0", fontcolor="#1a1a1a", fontsize=7]
    T_MATCH_STATE [label="/match_\nstate", shape=box, style="filled", fillcolor="#b0b0b0", fontcolor="#1a1a1a", fontsize=7]
    T_TAC_SCORE [label="/tactical_\nscore", shape=box, style="filled", fillcolor="#b0b0b0", fontcolor="#1a1a1a", fontsize=7]
    T_TAC_REWARD [label="/tactical_\nreward", shape=box, style="filled", fillcolor="#b0b0b0", fontcolor="#1a1a1a", fontsize=7]
    T_CMD_BLUE [label="/blue_1/\ncmd_vel\n/blue_2/\ncmd_vel", shape=box, style="filled", fillcolor="#b0b0b0", fontcolor="#1a1a1a", fontsize=6]
    T_CMD_RED [label="/red_1/\ncmd_vel\n/red_2/\ncmd_vel", shape=box, style="filled", fillcolor="#b0b0b0", fontcolor="#1a1a1a", fontsize=6]
    T_SET_ENTITY [label="/gazebo/\nset_entity_\nstate", shape=box, style="filled", fillcolor="#b0b0b0", fontcolor="#1a1a1a", fontsize=6]

    // ====== EDGES: publish (blue arrows, source = node) ======
    GAZEBO -> T_MODEL_STATES [color="#42a5f5", penwidth=1.5, arrowsize=0.7]
    GAZEBO -> T_CLOCK [color="#42a5f5", penwidth=1.5, arrowsize=0.7]
    TRACKER -> T_WORLD_POS [color="#42a5f5", penwidth=1.5, arrowsize=0.7]
    REFEREE -> T_MATCH_STATE [color="#42a5f5", penwidth=1.5, arrowsize=0.7]
    SCORE -> T_TAC_SCORE [color="#42a5f5", penwidth=1.5, arrowsize=0.7]
    REWARD -> T_TAC_REWARD [color="#42a5f5", penwidth=1.5, arrowsize=0.7]
    RED -> T_CMD_RED [color="#42a5f5", penwidth=1.5, arrowsize=0.7]
    BRIDGE -> T_CMD_BLUE [color="#42a5f5", penwidth=1.5, arrowsize=0.7]
    BRIDGE -> T_SET_ENTITY [color="#42a5f5", penwidth=1.2, arrowsize=0.6]
    REFEREE -> T_CMD_BLUE [color="#42a5f5", penwidth=1.0, arrowsize=0.5, style=dashed, label="freeze"]

    // ====== EDGES: subscribe (green arrows, target = node) ======
    T_MODEL_STATES -> TRACKER [color="#66bb6a", penwidth=1.5, arrowsize=0.7]
    T_MODEL_STATES -> RED [color="#66bb6a", penwidth=1.2, arrowsize=0.6]
    T_MODEL_STATES -> BRIDGE [color="#66bb6a", penwidth=1.2, arrowsize=0.6]
    T_CLOCK -> BRIDGE [color="#66bb6a", penwidth=1.2, arrowsize=0.6]
    T_WORLD_POS -> REFEREE [color="#66bb6a", penwidth=1.5, arrowsize=0.7]
    T_WORLD_POS -> SCORE [color="#66bb6a", penwidth=1.5, arrowsize=0.7]
    T_WORLD_POS -> AGG [color="#66bb6a", penwidth=1.2, arrowsize=0.6]
    T_MATCH_STATE -> REWARD [color="#66bb6a", penwidth=1.2, arrowsize=0.6]
    T_MATCH_STATE -> RED [color="#66bb6a", penwidth=1.2, arrowsize=0.6]
    T_MATCH_STATE -> AGG [color="#66bb6a", penwidth=1.0, arrowsize=0.5]
    T_TAC_SCORE -> REWARD [color="#66bb6a", penwidth=1.2, arrowsize=0.6]
    T_TAC_SCORE -> AGG [color="#66bb6a", penwidth=1.0, arrowsize=0.5]
    T_TAC_REWARD -> AGG [color="#66bb6a", penwidth=1.0, arrowsize=0.5]

    // ====== LAYOUT GROUPING ======
    {rank=same; GAZEBO; T_MODEL_STATES; T_CLOCK}
    {rank=same; TRACKER; T_WORLD_POS}
    {rank=same; REFEREE; SCORE; T_MATCH_STATE; T_TAC_SCORE}
    {rank=same; REWARD; RED; T_TAC_REWARD}
    {rank=same; AGG; BRIDGE; T_CMD_BLUE; T_CMD_RED; T_SET_ENTITY}
}