<?xml version="1.0" ?>
<robot name="box_bot">
  <material name="red"><color rgba="0.8 0.0 0.0 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.0 0.8 1.0"/></material>

  <link name="base_link"/>
  <joint name="base_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.05"/>
    <parent link="base_link"/>
    <child link="chassis"/>
  </joint>

  <link name="chassis">
    <inertial>
      <mass value="1.0"/>
      <origin rpy="0 0 0" xyz="0 0 -0.025"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <collision>
      <geometry><box size="0.16 0.16 0.1"/></geometry>
    </collision>
    <visual>
      <geometry><box size="0.16 0.16 0.1"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <gazebo reference="chassis"><material>Gazebo/Red</material></gazebo>

  <link name="right_wheel">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.01" radius="0.035"/></geometry>
    </collision>
    <visual>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.01" radius="0.035"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="joint_right_wheel" type="continuous">
    <origin rpy="0 0 0" xyz="0 -0.09 -0.025"/>
    <child link="right_wheel"/>
    <parent link="chassis"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
  </joint>

  <link name="left_wheel">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.01" radius="0.035"/></geometry>
    </collision>
    <visual>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.01" radius="0.035"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="joint_left_wheel" type="continuous">
    <origin rpy="0 0 0" xyz="0 0.09 -0.025"/>
    <child link="left_wheel"/>
    <parent link="chassis"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
  </joint>

  <gazebo>
    <plugin filename="libgazebo_ros_diff_drive.so" name="box_bot_diff_drive">
      <ros></ros>
      <left_joint>joint_left_wheel</left_joint>
      <right_joint>joint_right_wheel</right_joint>
      <wheel_separation>0.18</wheel_separation>
      <wheel_diameter>0.07</wheel_diameter>
      <max_wheel_torque>10</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>
</robot>
