<?xml version="1.0"?>
<robot name="soccer_ball">
  <link name="ball_link">
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.11"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.11"/>
      </geometry>
      <surface>
        <contact>
          <ode>
            <kp>50000.0</kp>
            <kd>1.0</kd>
            <max_vel>20.0</max_vel>
            <min_depth>0.01</min_depth>
          </ode>
          <collide_bitmask>0xffff</collide_bitmask>
        </contact>
        <bounce>
          <restitution_coefficient>1.0</restitution_coefficient>
          <threshold>0.0</threshold>
        </bounce>
        <friction>
          <ode>
            <mu>0.01</mu>
            <mu2>0.01</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>
  <gazebo reference="ball_link">
    <velocity_decay>
      <linear>0.002</linear>
      <angular>0.002</angular>
    </velocity_decay>
  </gazebo>
  <gazebo reference="ball_link">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo>
    <plugin name="ball_drive" filename="libgazebo_ros_planar_move.so">
      <ros><namespace>/ball</namespace></ros>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>ball_link</robot_base_frame>
    </plugin>
  </gazebo>
</robot>
