+  // ROS2K patch: force bot colors by model name (bypasses material pipeline).
+  // GZWeb's parseMaterial relies on the ~/material topic delivering Gazebo
+  // material script colors, which is unreliable. Instead, traverse the model
+  // after creation and set colors based on the model name.
+  if (modelObj.name) {
+    var color = null;
+    if (modelObj.name.indexOf("blue") >= 0) color = 0x2266cc;
+    else if (modelObj.name.indexOf("red") >= 0) color = 0xcc3322;
+    else if (modelObj.name === "soccer_ball") color = 0xffffff;
+    if (color !== null) {
+      modelObj.traverse(function(child) {
+        if (child.material) { child.material.color.setHex(color); }
+      });
+    }
+  }
   return modelObj;
